services:
  ermes-node:
    image: debian:bookworm-slim
    container_name: ermes-test-node
    restart: unless-stopped
    network_mode: host
    command: ["/usr/local/bin/ermes-node", "/etc/ermes-node/config.yaml"]
    volumes:
      - ./bin/ermes-node:/usr/local/bin/ermes-node:ro
      - ./config:/etc/ermes-node:ro
      - ./logs:/var/log/ermes-node

  redis:
    image: redis:7-alpine
    container_name: ermes-test-redis
    restart: unless-stopped
    network_mode: host
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis-data:/data

{% if 'cloud_nodes' in group_names %}
  minio:
    image: minio/minio:latest
    container_name: ermes-test-minio
    restart: unless-stopped
    network_mode: host
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: "{{ minio_root_user }}"
      MINIO_ROOT_PASSWORD: "{{ minio_root_password }}"
    volumes:
      - minio-data:/data
{% endif %}

volumes:
  redis-data:
{% if 'cloud_nodes' in group_names %}
  minio-data:
{% endif %}
