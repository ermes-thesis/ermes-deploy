# Redis configuration managed by Ansible
# Instance Port: {{ redis_port }}

# --- MODULES ---
# loadmodule /usr/lib/redis/modules/rejson.so
# loadmodule /usr/lib/redis/modules/redisbloom.so
# loadmodule /usr/lib/redis/modules/redistimeseries.so
loadmodule /usr/lib/redis/modules/redisearch.so

# --- NETWORK ---
{% if redis_bind is defined %}
bind {{ redis_bind }}
{% else %}
bind 127.0.0.1
{% endif %}

port {{ redis_port }}

{% if redis_protected_mode is defined %}
protected-mode {{ redis_protected_mode }}
{% else %}
protected-mode yes
{% endif %}

# --- SYSTEMD & PROCESS MANAGEMENT ---
supervised systemd
daemonize no

pidfile /var/run/redis/redis-{{ redis_port }}.pid

# --- LOGGING ---
{% if redis_logfile is defined and redis_logfile != "" %}
logfile {{ redis_logfile }}_{{ redis_port }}.log
{% else %}
logfile /var/log/redis/redis-{{ redis_port }}.log
{% endif %}

loglevel notice

# --- DATA STORAGE ---
dir /var/lib/redis/{{ redis_port }}

# --- AUTHENTICATION ---
{% if redis_password is defined %}
requirepass {{ redis_password }}
{% endif %}

# --- MEMORY ---
{% if redis_maxmemory is defined %}
maxmemory {{ redis_maxmemory }}
{% endif %}

{% if redis_maxmemory_policy is defined %}
maxmemory-policy {{ redis_maxmemory_policy }}
{% endif %}

# --- PERSISTENCE ---
{% if redis_save is defined %}
save {{ redis_save }}
{% endif %}

{% if redis_appendonly is defined %}
appendonly {{ redis_appendonly }}
{% endif %}

# --- TUNING ---
tcp-backlog 511
timeout 0
tcp-keepalive 300

databases 1

set-proc-title yes
proc-title-template "{title} :{{ redis_port }} {listen-addr} {server-mode}"

locale-collate ""
rdbcompression yes