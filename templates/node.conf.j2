{% set node = (nodes | selectattr("address","equalto", ansible_host) | list) %}
{% if node %}
  {% set node = node[0] %}
{% else %}
  {% set node = None %}
{% endif %}

{% if node is none %}
# WARNING: No node found for inventory_hostname={{ inventory_hostname }}
{% else %}

# === Node config ===
node:
  name: "{{ node.address }}:{{ common.port }}"
  domain: "{{ node.domain }}"
  address: "{{ node.address }}"
  port: {{ common.port }}
  secret: "{{ common.secret }}"
  clientSecret: "{{ common.clientSecret }}"

hierarchy:
{% set parts = node.domain.split('/') %}
{% if parts|length > 1 %}
{% set father_domain = parts[:-1] | join('/') %}
{% set father_node = nodes | selectattr("domain","equalto", father_domain) | first %}
  father:
    address: "{{ father_node.address }}:{{ common.port }}"
    domain: "{{ father_node.domain }}"
    latency_up: {{ node.latency_up }}
{% endif %}

{% set cloud_node = nodes | selectattr("is_cloud","equalto", True) | first %}
  cloud:
    address: "{{ cloud_node.address }}:{{ common.port }}"
    domain: "{{ cloud_node.domain }}"

{% set children = nodes | selectattr("domain", "match", "^" ~ node.domain ~ "/[^/]+$") | list %}
  children:
{% if children %}
{% for child in children|sort(attribute="latency_up") %}
    - address: "{{ child.address }}:{{ common.port }}"
      domain: "{{ child.domain }}"
      latency_up: {{ child.latency_up }}
{% endfor %}
{% else %}
    []
{% endif %}


# === Common config ===
{% set filtered_common = common | dict2items | rejectattr('key','in',['port','secret','clientSecret']) | list %}
{% set filtered_common_dict = {} %}
{% for item in filtered_common %}
{% set _ = filtered_common_dict.update({ item.key: item.value }) %}
{% endfor %}
{{ filtered_common_dict | to_nice_yaml(indent=2) }}

{% endif %}
